{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ohmy-adapter-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "job_id",
    "ohmy_revision",
    "normalized_contract_version",
    "omp_revision",
    "origin",
    "run_id",
    "session_id",
    "lifecycle",
    "evidence_complete",
    "transport",
    "failure_source",
    "failure_code",
    "http_status",
    "retry_exhausted",
    "final_output",
    "tool_calls",
    "implementation_activity"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "ansible.ohmy-summary.v1"},
    "job_id": {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[0-9a-f]{32}$"},
    "ohmy_revision": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "normalized_contract_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "omp_revision": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
    "origin": {"type": "string", "enum": ["SYNTHETIC", "RECORDED", "LIVE"]},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"},
    "lifecycle": {"type": "string", "enum": ["agent_settled", "local_only", "command_failed", "indeterminate"]},
    "evidence_complete": {"type": "boolean"},
    "transport": {"type": "string", "enum": ["ready", "protocol_failed", "connection_failed", "retry_exhausted"]},
    "failure_source": {"type": "string", "enum": ["NONE", "COMMAND", "ASSISTANT", "RETRY", "EXTENSION", "TRANSPORT", "MAINTENANCE"]},
    "failure_code": {"type": "string", "enum": ["NONE", "UNCLASSIFIED", "AUTHENTICATION", "QUOTA_EXHAUSTED", "RATE_LIMITED", "PROVIDER_UNAVAILABLE", "MODEL_UNAVAILABLE", "CONTEXT_LIMIT", "NETWORK", "CANCELLED", "RETRY_EXHAUSTED", "SCHEDULING", "PROTOCOL", "SESSION_BUSY", "STALE_CURSOR"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "retry_exhausted": {"type": "boolean"},
    "final_output": {"type": ["string", "null"], "maxLength": 8192},
    "tool_calls": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "implementation_activity": {"type": "boolean"}
  }
}
