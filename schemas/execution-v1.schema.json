{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "execution-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "runner_id",
    "provider_id",
    "parameters",
    "capabilities",
    "timeout_seconds",
    "resources"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "ansible.execution.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "runner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "parameters": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mb",
        "cpu_seconds"
      ],
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 512
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
