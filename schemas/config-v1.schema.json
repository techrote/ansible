{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "techrote/ansible local config v1",
  "description": "Operator-owned local configuration. It is not task data and cannot register runners or commands.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$comment": {"type": "string", "maxLength": 4000},
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intrallm": {"type": "string", "minLength": 1, "maxLength": 1000},
        "dashminimix": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "slots_dir": {"type": "string", "minLength": 1, "maxLength": 220},
    "approved_models": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,119}$"}
    },
    "local_state_dir": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
